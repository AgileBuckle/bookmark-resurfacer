# Session encryption key (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-in-production

# Void Auth SSO (leave CLIENT_ID blank to skip auth in single-user mode)
# Fill these in once you have your Void Auth instance set up.
# See README.md for setup instructions.
VOID_AUTH_CLIENT_ID=
VOID_AUTH_CLIENT_SECRET=
VOID_AUTH_DOMAIN=https://voidauth.example.com
VOID_AUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# SMTP Configuration (fallback defaults — use /settings UI to override)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Email
EMAIL_FROM=
EMAIL_TO=
EMAIL_SUBJECT=Your Bookmarks to Revisit

# Schedule
LINKS_PER_EMAIL=5
SCHEDULE_INTERVAL_HOURS=24
