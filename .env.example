# ---------------------------------------------------------------------------
# Copy to .env and fill in. `.env` is gitignored — never commit real secrets.
# Recommended: chmod 600 .env
# ---------------------------------------------------------------------------

# "development" or "production". In production the app refuses to start with a
# weak SESSION_SECRET, requires https for SSO, and enables HSTS.
ENVIRONMENT=development

# REQUIRED. Signs the session cookie. A guessable value lets anyone forge a
# session for any user. Must be >= 32 chars. Generate with:
#   openssl rand -hex 32
# Leave blank in development to get a random ephemeral secret (sessions are
# dropped on every restart).
SESSION_SECRET=

# --- Void Auth SSO ---------------------------------------------------------
# Leave VOID_AUTH_CLIENT_ID blank to run WITHOUT AUTHENTICATION (single shared
# local user). In that mode anyone who can reach the port has full access to
# your bookmarks and stored SMTP password — bind to localhost only.
# VOID_AUTH_DOMAIN must be https.
VOID_AUTH_CLIENT_ID=
VOID_AUTH_CLIENT_SECRET=
VOID_AUTH_DOMAIN=https://voidauth.example.com
VOID_AUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Optional comma-separated allowlist. When set, only these email addresses may
# sign in — otherwise any account on your Void Auth instance can self-register.
ALLOWED_EMAILS=

# --- HTTP hardening --------------------------------------------------------
# Comma-separated hostnames allowed in the Host header. "*" disables the check;
# set your real hostname in production to block Host-header poisoning.
ALLOWED_HOSTS=*

# Send the session cookie only over HTTPS. Defaults to true in production.
COOKIE_SECURE=

# Session lifetime in seconds (default 7 days). Sessions are stateless signed
# cookies, so a stolen cookie stays valid until it expires — keep this short.
SESSION_MAX_AGE_SECONDS=604800

# Expose /docs, /redoc and /openapi.json. Defaults to true only in development.
EXPOSE_DOCS=

# --- Rate limits (per process) ---------------------------------------------
TEST_EMAIL_LIMIT_PER_HOUR=5
LOGIN_LIMIT_PER_HOUR=20

# --- Storage ---------------------------------------------------------------
# Directory for bookmarks.db. Created with mode 700; the DB file holds the
# SMTP password in plaintext.
# DATA_DIR=./data

# --- Docker ----------------------------------------------------------------
# Must match the owner of ./data on the host. Use `id -u` / `id -g` if the
# container reports permission errors on the data volume.
APP_UID=10001
APP_GID=10001

# ---------------------------------------------------------------------------
# NOTE: SMTP and schedule settings are configured per user in the /settings UI
# and stored in the database. They are not read from this file.
# ---------------------------------------------------------------------------
